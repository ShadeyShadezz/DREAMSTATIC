# Copy this file to .env and fill in real values.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres (Neon / Vercel Postgres) connection string
# For Vercel: add DATABASE_URL in your Vercel Project Dashboard → Settings → Environment Variables
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require

# OpenAI API key (used server-side for DreamAI chat)
OPENAI_API_KEY=sk-REPLACE_ME

# ─── Optional ────────────────────────────────────────────────────────────────

# Unsplash access key – only needed if you enable image search in the builder
UNSPLASH_ACCESS_KEY=REPLACE_ME

# ─── Vercel Deploy Notes ─────────────────────────────────────────────────────
# 1. Push the repo to GitHub and import the project at https://vercel.com/new
# 2. Add these environment variables in the Vercel dashboard (Settings → Environment Variables)
# 3. For the database, Neon (https://neon.tech) provides a free PostgreSQL tier with a connection
#    string compatible with this app. Copy your connection string into DATABASE_URL.
# 4. Deploy – the build pipeline will automatically run `prisma generate` via the postinstall hook.
